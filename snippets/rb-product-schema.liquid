{% doc %}
  Emits a single schema.org Product JSON-LD entity for one-of-one resale items.
  Replaces Shopify's `structured_data` filter so we can declare item condition, seller and the
  store's "All Sales Final" return policy. Rendered from sections/product-information.liquid.

  - url is always the canonical /products/<handle> (never the /collections/x/products/y variant).
  - itemCondition comes from import-pipeline tags: used / lightly-used / vintage-wear -> UsedCondition,
    deadstock -> NewCondition, no tag -> omitted. Used tags win if a product carries both.
  - No shippingDetails: rates aren't defined in the theme, so we don't guess them.

  @param {object} product - The product to describe
{% enddoc %}
{%- if product != blank -%}
  {%- liquid
    assign root_path = routes.root_url
    if root_path == '/'
      assign root_path = ''
    endif
    assign product_canonical_url = shop.url | append: root_path | append: '/products/' | append: product.handle
    assign schema_currency = cart.currency.iso_code | default: shop.currency

    assign item_condition = ''
    if product.tags contains 'used' or product.tags contains 'lightly-used' or product.tags contains 'vintage-wear'
      assign item_condition = 'https://schema.org/UsedCondition'
    elsif product.tags contains 'deadstock'
      assign item_condition = 'https://schema.org/NewCondition'
    endif

    # Break block tags into spaces before stripping, then collapse whitespace.
    assign schema_description = product.description | replace: '</p>', '</p> ' | replace: '<br', ' <br' | replace: '</li>', '</li> ' | strip_html | split: ' ' | join: ' ' | strip | truncate: 1000
    if schema_description == blank
      assign schema_description = product.title | strip_html
    endif

    capture schema_images
      for image in product.images limit: 10
        unless forloop.first
          echo ','
        endunless
        echo image | image_url: width: 1600 | prepend: 'https:' | json
      endfor
    endcapture

    capture schema_offers
      for variant in product.variants
        unless forloop.first
          echo ','
        endunless
        echo '{"@type":"Offer","url":'
        echo product_canonical_url | append: '?variant=' | append: variant.id | json
        if variant.sku != blank
          echo ',"sku":'
          echo variant.sku | json
        endif
        echo ',"price":'
        echo variant.price | divided_by: 100.0 | json
        echo ',"priceCurrency":'
        echo schema_currency | json
        if variant.available
          echo ',"availability":"https://schema.org/InStock"'
        else
          echo ',"availability":"https://schema.org/OutOfStock"'
        endif
        if item_condition != ''
          echo ',"itemCondition":'
          echo item_condition | json
        endif
        echo ',"seller":{"@type":"Organization","name":'
        echo shop.name | json
        echo '}'
        echo ',"hasMerchantReturnPolicy":{"@type":"MerchantReturnPolicy","applicableCountry":"US","returnPolicyCategory":"https://schema.org/MerchantReturnNotPermitted"}'
        echo '}'
      endfor
    endcapture

    assign schema_sku = product.selected_or_first_available_variant.sku
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | strip_html | json }},
      "url": {{ product_canonical_url | json }},
      {%- if schema_images != blank %}
      "image": [{{ schema_images }}],
      {%- endif %}
      "description": {{ schema_description | json }},
      {%- if schema_sku != blank %}
      "sku": {{ schema_sku | json }},
      {%- endif %}
      {%- if product.vendor != blank %}
      "brand": {"@type": "Brand", "name": {{ product.vendor | json }}},
      {%- endif %}
      "offers": [{{ schema_offers }}]
    }
  </script>
{%- endif -%}
